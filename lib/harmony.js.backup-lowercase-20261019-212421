export const HARMONY_TYPES = [
  { id: "complementary", value: "complementary", label: "Complementary" },
  { id: "analogous", value: "analogous", label: "Analogous" },
  { id: "triadic", value: "triadic", label: "Triadic" },
  { id: "split-complementary", value: "split-complementary", label: "Split complementary" },
  { id: "tetradic", value: "tetradic", label: "Tetradic" },
  { id: "square", value: "square", label: "Square" },
  { id: "monochromatic", value: "monochromatic", label: "Monochromatic" },
];

export const PALETTE_SIZES = [9, 12, 16, 24];

function hexToHsl(hex) {
  const clean = hex.replace("#", "");
  const r = parseInt(clean.slice(0, 2), 16) / 255;
  const g = parseInt(clean.slice(2, 4), 16) / 255;
  const b = parseInt(clean.slice(4, 6), 16) / 255;

  const max = Math.max(r, g, b);
  const min = Math.min(r, g, b);
  const delta = max - min;
  let h = 0;
  let s = 0;
  const l = (max + min) / 2;

  if (delta !== 0) {
    s = delta / (1 - Math.abs(2 * l - 1));

    if (max === r) h = 60 * (((g - b) / delta) % 6);
    else if (max === g) h = 60 * ((b - r) / delta + 2);
    else h = 60 * ((r - g) / delta + 4);
  }

  return { h: (h + 360) % 360, s: s * 100, l: l * 100 };
}

function hslToHex(h, s, l) {
  h = ((h % 360) + 360) % 360;
  s = Math.max(0, Math.min(100, s)) / 100;
  l = Math.max(0, Math.min(100, l)) / 100;

  const c = (1 - Math.abs(2 * l - 1)) * s;
  const x = c * (1 - Math.abs(((h / 60) % 2) - 1));
  const m = l - c / 2;
  let r = 0, g = 0, b = 0;

  if (h < 60) [r, g, b] = [c, x, 0];
  else if (h < 120) [r, g, b] = [x, c, 0];
  else if (h < 180) [r, g, b] = [0, c, x];
  else if (h < 240) [r, g, b] = [0, x, c];
  else if (h < 300) [r, g, b] = [x, 0, c];
  else [r, g, b] = [c, 0, x];

  return "#" + [r, g, b]
    .map((v) => Math.round((v + m) * 255).toString(16).padStart(2, "0"))
    .join("")
    .toUpperCase();
}

function harmonyAngles(type) {
  switch (type) {
    case "complementary":
      return [0, 180];
    case "analogous":
      return [-40, -30, -20, -10, 0, 10, 20, 30, 40];
    case "triadic":
      return [0, 120, 240];
    case "split-complementary":
      return [0, 150, 210];
    case "tetradic":
      return [0, 90, 180, 270];
    case "square":
      return [0, 90, 180, 270];
    case "monochromatic":
      return [0];
    default:
      throw new Error(`Unknown harmony type: ${type}`);
  }
}

/**
 * Generates a palette with a requested number of colors.
 * Anchor hues preserve the selected harmony; varied lightness and saturation
 * give the palette useful options for backgrounds, accents and text.
 */
export function makeHarmony(base, type = "complementary", count = 9) {
  if (typeof base !== "string" || !/^#?(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/.test(base.trim())) {
    throw new Error("Invalid base color: expected a 3- or 6-digit hex color.");
  }

  if (!HARMONY_TYPES.some((item) => item.value === type)) {
    throw new Error(`Unknown harmony type: ${type}`);
  }

  if (!Number.isInteger(count) || count < 1 || count > 100) {
    throw new Error("Color count must be an integer from 1 to 100.");
  }

  let digits = base.trim().replace(/^#/, "").toLowerCase();
  if (digits.length === 3) {
    digits = [...digits].map((digit) => digit + digit).join("");
  }
  const normalized = `#${digits}`;
  const { h, s, l } = hexToHsl(normalized);
  const anchors = harmonyAngles(type);

  const colors = Array.from({ length: count }, (_, index) => {
    const anchorIndex = index % anchors.length;
    const cycle = Math.floor(index / anchors.length);
    const cycles = Math.max(1, Math.ceil(count / anchors.length));

    let hue = h + anchors[anchorIndex];
    let saturation = s;
    let lightness = l;

    if (type === "monochromatic") {
      const progress = count === 1 ? 0.5 : index / (count - 1);
      lightness = 18 + progress * 68;
      saturation = Math.max(18, Math.min(95, s));
    } else if (cycle > 0) {
      // Add useful shades around each harmony hue without changing its scheme.
      const progress = cycle / cycles;
      const lightnessShift = cycle % 2 === 1 ? -16 * progress : 16 * progress;
      lightness = Math.max(22, Math.min(82, l + lightnessShift));
      saturation = Math.max(25, Math.min(95, s + (cycle % 2 ? 8 : -5)));
    }

    const hex = index === 0 ? normalized : hslToHex(hue, saturation, lightness);

    return {
      hex,
      role: index === 0 ? "Base color" : `Color ${index + 1}`,
      isBase: index === 0,
    };
  });

  // Avoid duplicate colors where possible by varying lightness in small steps.
  const used = new Set([colors[0].hex]);
  for (let i = 1; i < colors.length; i++) {
    if (used.has(colors[i].hex)) {
      const original = hexToHsl(colors[i].hex);
      let replacement = colors[i].hex;
      for (let step = 1; step <= 15 && used.has(replacement); step++) {
        replacement = hslToHex(
          original.h,
          original.s,
          Math.max(12, Math.min(88, original.l + (step % 2 ? step : -step)))
        );
      }
      colors[i].hex = replacement;
    }
    used.add(colors[i].hex);
  }

  return colors;
}

export function harmonyAsCss(colors) {
  return [
    ":root {",
    ...colors.map(
      (color, index) => `  --harmony-${index + 1}: ${color.hex.toLowerCase()};`
    ),
    "}",
  ].join("\n");
}
