/* Momentum theme tokens. Light is the default; dark overrides it.
   Text pairs are checked against WCAG AA by tests/theme.test.mjs. */
:root {
  --bg: #f7f7f5;
  --surface: #ffffff;
  --surface2: #f0f0eb;
  --ink: #20211e;
  --muted: #666860;
  --line: #e5e5de;
  --accent: #c9f27a;
  --accent-ink: #26331a;
  --focus: #26331a;
  --danger: #b3261e;
  --shadow: 0 12px 35px rgba(32, 33, 30, 0.05);
  --radius: 15px;
  color-scheme: light;
}

[data-theme="dark"] {
  --bg: #171815;
  --surface: #22231f;
  --surface2: #2b2c27;
  --ink: #f1f1e9;
  --muted: #a6a79d;
  --line: #3b3c35;
  --accent: #c9f27a;
  --accent-ink: #26331a;
  --focus: #c9f27a;
  --danger: #ff9a8d;
  --shadow: 0 12px 35px rgba(0, 0, 0, 0.2);
  color-scheme: dark;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
}

body {
  background: var(--bg);
  color: var(--ink);
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  line-height: 1.5;
}

a {
  color: inherit;
}

:focus-visible {
  outline: 3px solid var(--focus);
  outline-offset: 2px;
}

.skip-link {
  position: absolute;
  left: -999px;
  top: 8px;
  z-index: 100;
  padding: 8px 14px;
  border-radius: 10px;
  background: var(--accent);
  color: var(--accent-ink);
}
.skip-link:focus {
  left: 8px;
}

/* layout */
.shell {
  display: grid;
  grid-template-columns: 248px 1fr;
  min-height: 100vh;
}

.sidebar {
  position: sticky;
  top: 0;
  align-self: start;
  height: 100vh;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 18px;
  padding: 20px 14px;
  background: var(--surface);
  border-right: 1px solid var(--line);
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 4px 8px;
  font-size: 1.05rem;
  font-weight: 700;
  text-decoration: none;
}

.brand-mark {
  display: grid;
  place-items: center;
  width: 30px;
  height: 30px;
  border-radius: 10px;
  background: var(--accent);
  color: var(--accent-ink);
  font-weight: 800;
}

.nav-group {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.nav-label {
  padding: 6px 10px;
  font-size: 0.75rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--muted);
}

.nav-link {
  display: block;
  padding: 9px 12px;
  border-radius: 10px;
  color: var(--ink);
  text-decoration: none;
}
.nav-link:hover {
  background: var(--surface2);
}
.nav-link[aria-current="page"] {
  background: var(--accent);
  color: var(--accent-ink);
  font-weight: 600;
}

.sidebar-footer {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: auto;
}

.main {
  width: 100%;
  max-width: 1100px;
  padding: 32px clamp(18px, 4vw, 48px) 64px;
}

/* building blocks */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 16px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--surface);
  color: var(--ink);
  font: inherit;
  text-decoration: none;
  cursor: pointer;
}
.btn:hover {
  background: var(--surface2);
}
.btn[aria-pressed="true"] {
  background: var(--accent);
  color: var(--accent-ink);
  border-color: transparent;
  font-weight: 600;
}
.btn-primary {
  background: var(--accent);
  color: var(--accent-ink);
  border-color: transparent;
  font-weight: 600;
}
.btn-primary:hover {
  background: var(--accent);
  filter: brightness(0.95);
}

.card {
  padding: 22px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}

.hero {
  padding: clamp(16px, 4vw, 48px) 0;
}
.hero h1 {
  max-width: 16ch;
  margin: 0 0 14px;
  font-size: clamp(2rem, 5vw, 3.4rem);
  line-height: 1.08;
}
.lede {
  max-width: 52ch;
  margin: 0 0 20px;
  font-size: 1.1rem;
  color: var(--muted);
}
.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.swatch-row {
  display: flex;
  margin-top: 32px;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: var(--radius);
}
.swatch-row span {
  flex: 1;
  height: 64px;
}

.page-title {
  margin: 0 0 6px;
  font-size: 1.9rem;
}
.muted {
  color: var(--muted);
}

@media (max-width: 820px) {
  .shell {
    grid-template-columns: 1fr;
  }
  .sidebar {
    position: static;
    height: auto;
    border-right: 0;
    border-bottom: 1px solid var(--line);
  }
  .nav-group {
    flex-direction: row;
    flex-wrap: wrap;
  }
  .nav-label {
    width: 100%;
  }
}

@media (prefers-reduced-motion: reduce) {
  * {
    transition: none !important;
    animation: none !important;
  }
}

/* ---------- forms ---------- */
.field {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 14px;
}
.field.grow {
  flex: 1;
  min-width: 200px;
}
.field-row {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  gap: 12px;
  margin-bottom: 14px;
}
.field-row .field {
  flex: 1;
  min-width: 140px;
  margin-bottom: 0;
}
label,
.label {
  font-size: 0.9rem;
  font-weight: 600;
}
input[type="text"],
input[type="search"],
input[type="email"],
input[type="password"],
select {
  width: 100%;
  padding: 10px 12px;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: var(--surface);
  color: var(--ink);
  font: inherit;
}
input[aria-invalid="true"] {
  border-color: var(--danger);
}
::placeholder {
  color: var(--muted);
  opacity: 1;
}
input[type="color"] {
  width: 48px;
  height: 42px;
  padding: 2px;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: var(--surface);
  cursor: pointer;
}
.hex-row {
  display: flex;
  gap: 8px;
}
.hex-row input[type="text"] {
  flex: 1;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
}
.check {
  display: flex;
  gap: 10px;
  align-items: flex-start;
  margin: 4px 0 14px;
  font-weight: 400;
}
.check input {
  margin-top: 4px;
}
.error {
  margin: 0;
  font-size: 0.88rem;
  color: var(--danger);
}
.btn[disabled] {
  opacity: 0.55;
  cursor: not-allowed;
}
.btn-danger {
  color: var(--danger);
  border-color: var(--danger);
}
.inline-form {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
}
.segmented {
  display: inline-flex;
  flex-wrap: wrap;
  border: 1px solid var(--line);
  border-radius: 12px;
  overflow: hidden;
}
.seg {
  padding: 8px 14px;
  border: 0;
  background: var(--surface);
  color: var(--ink);
  font: inherit;
  cursor: pointer;
}
.seg + .seg {
  border-left: 1px solid var(--line);
}
.seg:hover {
  background: var(--surface2);
}
.seg[aria-pressed="true"] {
  background: var(--accent);
  color: var(--accent-ink);
  font-weight: 600;
}

/* ---------- content ---------- */
.lede-sm {
  margin: 0 0 20px;
}
.stack {
  display: flex;
  flex-direction: column;
  gap: 20px;
  max-width: 640px;
}
.small {
  font-size: 0.85rem;
}
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  margin: -1px;
  padding: 0;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
  border: 0;
}
.card-title {
  margin: 0 0 14px;
  font-size: 1.05rem;
}
.card + .card {
  margin-top: 20px;
}
.actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10px;
  margin: 14px 0;
}
code {
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 0.9em;
}

.strip {
  display: flex;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 12px;
}
.strip span {
  flex: 1;
  height: 40px;
}
.strip-tall span {
  height: 72px;
}

.studio {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 20px;
  align-items: start;
}
.studio-col {
  display: flex;
  flex-direction: column;
  gap: 20px;
  min-width: 0;
}
.studio-col > .card + .card {
  margin-top: 0;
}

.scale {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(92px, 1fr));
  gap: 8px;
  margin: 0 0 10px;
  padding: 0;
  list-style: none;
}
.swatch {
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: flex-start;
  width: 100%;
  height: 68px;
  padding: 8px;
  border: 1px solid var(--line);
  border-radius: 12px;
  font: inherit;
  cursor: pointer;
}
.swatch-step {
  font-weight: 700;
  font-size: 0.85rem;
}
.swatch-hex {
  font-size: 0.75rem;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
}

.sample {
  padding: 18px;
  border: 1px solid var(--line);
  border-radius: 12px;
  font-size: 1.05rem;
}
.sample strong {
  font-size: 1.6rem;
  margin-right: 8px;
}
.ratio {
  margin: 12px 0 4px;
  font-size: 2rem;
  font-weight: 700;
}
.levels {
  margin: 0 0 12px;
  padding: 0;
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.level {
  display: inline-block;
  padding: 1px 8px;
  border: 1px solid var(--line);
  border-radius: 999px;
  font-size: 0.8rem;
  font-weight: 600;
  white-space: nowrap;
}
.level-fail {
  color: var(--danger);
  border-color: var(--danger);
}
summary {
  cursor: pointer;
  font-weight: 600;
  padding: 6px 0;
}
.table-wrap {
  overflow-x: auto;
}
table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.88rem;
}
th,
td {
  padding: 8px 10px;
  border-bottom: 1px solid var(--line);
  text-align: left;
  vertical-align: middle;
  white-space: nowrap;
}
.dot {
  display: inline-block;
  width: 12px;
  height: 12px;
  border: 1px solid var(--line);
  border-radius: 50%;
  vertical-align: middle;
}

.preview-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}
.small-title {
  margin: 0 0 8px;
  font-size: 0.9rem;
}
.mock {
  padding: 14px;
  border: 1px solid var(--line);
  border-radius: 12px;
  margin-bottom: 10px;
}
.mock-card {
  padding: 14px;
  border-radius: 10px;
}
.mock-heading {
  margin: 0;
  font-weight: 700;
}
.mock-button {
  display: inline-block;
  padding: 8px 14px;
  border-radius: 8px;
  font-weight: 600;
}

.dialog {
  width: min(680px, 92vw);
  padding: 0;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--surface);
  color: var(--ink);
}
.dialog::backdrop {
  background: rgba(0, 0, 0, 0.55);
}
.dialog-body {
  padding: 22px;
}
.dialog-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
}
.export .segmented {
  margin-bottom: 12px;
}
.code {
  margin: 0;
  max-height: 340px;
  overflow: auto;
  padding: 14px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--surface2);
  font-size: 0.85rem;
}

/* ---------- lists ---------- */
.toolbar {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  gap: 14px;
  margin-bottom: 14px;
}
.toolbar .field {
  margin-bottom: 0;
}
.grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 16px;
  margin: 0;
  padding: 0;
  list-style: none;
}
.grid .card + .card {
  margin-top: 0;
}
.system-card {
  display: flex;
  flex-direction: column;
  gap: 8px;
  height: 100%;
}
.system-name {
  margin: 4px 0 0;
  font-size: 1.05rem;
}
.system-name a {
  text-decoration: none;
}
.system-name a:hover {
  text-decoration: underline;
}
.system-card p {
  margin: 0;
}
.badge {
  align-self: flex-start;
  padding: 1px 10px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: var(--surface2);
  font-size: 0.78rem;
}
.card-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: auto;
  padding-top: 6px;
}
.fav[aria-pressed="true"] {
  border-color: var(--accent);
}
.pager {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16px;
  margin-top: 24px;
}
.empty {
  text-align: center;
}
.auth {
  max-width: 440px;
}
.auth .segmented {
  margin-bottom: 18px;
}
.account {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.account p {
  margin: 0;
}

@media (max-width: 1100px) {
  .studio {
    grid-template-columns: 1fr;
  }
}
@media (max-width: 560px) {
  .preview-grid {
    grid-template-columns: 1fr;
  }
}

/* Harmony palette */
.harmony-heading {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
}
.harmony-heading .card-title {
  margin-bottom: 4px;
  font-size: 1.25rem;
}
.eyebrow {
  margin: 0 0 5px;
  color: var(--muted);
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.1em;
}
.harmony-live {
  padding: 4px 9px;
  border: 1px solid var(--line);
  border-radius: 999px;
  color: var(--muted);
  font-size: 0.75rem;
  font-weight: 600;
}
.harmony-types {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin-top: 18px;
}
.harmony-type {
  padding: 7px 10px;
  font-size: 0.82rem;
}
.harmony-type[aria-pressed="true"] {
  background: var(--accent);
  color: var(--accent-ink);
  border-color: transparent;
  font-weight: 700;
}
.harmony-description {
  margin: 12px 0;
}
.harmony-colors {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(105px, 1fr));
  gap: 9px;
}
.harmony-swatch {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-end;
  gap: 5px;
  min-width: 0;
  min-height: 125px;
  padding: 11px 9px;
  border: 1px solid var(--line);
  border-radius: 12px;
  text-align: left;
  cursor: pointer;
  font: inherit;
  transition: transform 140ms ease, box-shadow 140ms ease;
}
.harmony-swatch:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow);
}
.harmony-role {
  font-size: 0.65rem;
  font-weight: 800;
  letter-spacing: 0.06em;
}
.harmony-hex {
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 0.82rem;
  font-weight: 750;
}
.harmony-contrast {
  font-size: 0.68rem;
  opacity: 0.9;
}
.harmony-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 14px;
}
.harmony-actions .btn {
  padding: 8px 11px;
  font-size: 0.85rem;
}
.harmony-note {
  margin: 14px 0 0;
  line-height: 1.55;
}
.harmony-feedback {
  margin: 8px 0 0;
}
@media (prefers-reduced-motion: reduce) {
  .harmony-swatch {
    transition: none;
  }
  .harmony-swatch:hover {
    transform: none;
  }
}

/* Harmony palette builder v2 */
.harmony-v2 {
  display: flex;
  flex-direction: column;
  gap: 18px;
  min-width: 0;
}

.harmony-v2-heading,
.harmony-v2-saved-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.harmony-v2-heading h2,
.harmony-v2-saved-heading h3 {
  margin: 0;
  color: var(--ink);
}

.harmony-v2-heading p,
.harmony-v2-empty {
  margin: 6px 0 0;
  color: var(--muted);
  font-size: 0.9rem;
}

.harmony-v2-count {
  flex-shrink: 0;
  padding: 6px 10px;
  border: 1px solid var(--line);
  border-radius: 999px;
  color: var(--ink);
  font-size: 0.8rem;
  font-weight: 650;
}

.harmony-v2-controls {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.harmony-v2-field {
  display: flex;
  flex-direction: column;
  gap: 7px;
  min-width: 0;
  color: var(--muted);
  font-size: 0.85rem;
  font-weight: 600;
}

.harmony-v2-field select,
.harmony-v2-field input {
  width: 100%;
  min-height: 42px;
  padding: 9px 12px;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: var(--surface);
  color: var(--ink);
  font: inherit;
}

.harmony-v2-field select:focus-visible,
.harmony-v2-field input:focus-visible,
.harmony-v2 button:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

.harmony-v2-swatches {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 9px;
}

.harmony-v2-swatch {
  position: relative;
  display: flex;
  min-width: 0;
  min-height: 86px;
  align-items: flex-end;
  justify-content: space-between;
  gap: 4px;
  padding: 8px;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 10px;
  color: #fff;
  cursor: pointer;
  text-align: left;
  box-shadow: inset 0 -36px 28px -22px rgb(0 0 0 / 34%);
  transition: transform 140ms ease, box-shadow 140ms ease;
}

.harmony-v2-swatch:hover {
  transform: translateY(-2px);
  box-shadow: inset 0 -36px 28px -22px rgb(0 0 0 / 48%);
}

.harmony-v2-swatch span {
  overflow-wrap: anywhere;
  font-size: 0.75rem;
  font-weight: 750;
  text-shadow: 0 1px 3px rgb(0 0 0 / 35%);
}

.harmony-v2-swatch small {
  align-self: flex-start;
  padding: 3px 5px;
  border-radius: 4px;
  background: rgb(0 0 0 / 30%);
  font-size: 0.58rem;
  letter-spacing: 0.04em;
}

.harmony-v2-actions,
.harmony-v2-export,
.harmony-v2-saved-buttons {
  display: flex;
  flex-wrap: wrap;
  align-items: end;
  gap: 9px;
}

.harmony-v2-export {
  padding-top: 16px;
  border-top: 1px solid var(--line);
}

.harmony-v2-export .harmony-v2-field {
  flex: 1 1 190px;
}

.harmony-v2-name {
  margin-top: -4px;
}

.harmony-v2-saved {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding-top: 16px;
  border-top: 1px solid var(--line);
}

.harmony-v2-saved-heading span {
  color: var(--muted);
  font-size: 0.85rem;
}

.harmony-v2-saved-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.harmony-v2-saved-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--surface2);
}

.harmony-v2-saved-info {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 5px;
  min-width: 0;
}

.harmony-v2-saved-info strong {
  overflow-wrap: anywhere;
  color: var(--ink);
  font-size: 0.9rem;
}

.harmony-v2-saved-info > span {
  color: var(--muted);
  font-size: 0.78rem;
}

.harmony-v2-mini-swatches {
  display: flex;
  flex-wrap: wrap;
  gap: 3px;
  margin-top: 3px;
}

.harmony-v2-mini-swatches span {
  width: 18px;
  height: 18px;
  border: 1px solid var(--line);
  border-radius: 5px;
}

.harmony-v2-saved-buttons {
  flex-shrink: 0;
  align-items: center;
}

.harmony-v2-status {
  margin: 0;
  color: var(--muted);
  font-size: 0.82rem;
}

@media (max-width: 600px) {
  .harmony-v2-controls {
    grid-template-columns: 1fr;
  }

  .harmony-v2-swatches {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .harmony-v2-saved-item {
    align-items: flex-start;
    flex-direction: column;
  }

  .harmony-v2-saved-buttons {
    width: 100%;
  }

  .harmony-v2-export > button {
    width: 100%;
  }
}

/* My Systems: local image color-extraction workspace */
.color-workspace {
  margin-bottom: 24px;
  min-width: 0;
}

.color-workspace-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14px;
  margin-bottom: 20px;
}

.color-workspace-heading h2,
.color-section-heading h3,
.extracted-heading h3 {
  margin: 0;
  color: var(--ink);
}

.color-workspace-heading .eyebrow {
  margin: 0 0 6px;
  color: var(--accent);
  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 0.13em;
}

.color-workspace-heading .muted {
  margin: 6px 0 0;
}

.color-workspace-count {
  flex-shrink: 0;
  padding: 6px 10px;
  border: 1px solid var(--line);
  border-radius: 999px;
  color: var(--ink);
  font-size: 0.8rem;
  font-weight: 700;
}

.color-workspace-columns {
  display: grid;
  grid-template-columns: minmax(210px, 0.8fr) minmax(0, 2fr);
  align-items: start;
  gap: 18px;
}

.color-library,
.image-extractor {
  min-width: 0;
  padding: 16px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: var(--surface2);
}

.color-library {
  position: sticky;
  top: 16px;
}

.color-section-heading,
.extracted-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 14px;
}

.color-section-heading h3,
.extracted-heading h3 {
  font-size: 1rem;
}

.color-section-heading p,
.extracted-heading p {
  margin: 5px 0 0;
}

.color-library-drop-hint {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 14px;
  padding: 11px;
  border: 1px dashed var(--accent);
  border-radius: 10px;
  color: var(--muted);
  font-size: 0.78rem;
}

.color-library-drop-hint > span {
  display: grid;
  width: 24px;
  height: 24px;
  place-items: center;
  border-radius: 7px;
  background: var(--surface);
  color: var(--accent);
  font-size: 1.1rem;
}

.color-library-empty {
  padding: 26px 8px;
  text-align: center;
}

.color-library-empty > span {
  color: var(--muted);
  font-size: 1.8rem;
}

.color-library-empty p {
  margin: 7px 0 0;
  font-size: 0.85rem;
}

.color-library-list {
  display: flex;
  flex-direction: column;
  gap: 7px;
  max-height: 440px;
  overflow: auto;
}

.color-library-item {
  display: grid;
  grid-template-columns: 34px minmax(0, 1fr) 28px;
  align-items: center;
  gap: 8px;
  min-width: 0;
  padding: 6px;
  border: 1px solid var(--line);
  border-radius: 9px;
  background: var(--surface);
}

.color-library-chip {
  width: 34px;
  height: 34px;
  border: 1px solid var(--line);
  border-radius: 7px;
  cursor: pointer;
}

.color-library-hex {
  min-width: 0;
  overflow: hidden;
  border: 0;
  background: transparent;
  color: var(--ink);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 0.77rem;
  text-align: left;
  text-overflow: ellipsis;
  cursor: pointer;
}

.color-library-remove {
  width: 28px;
  height: 28px;
  border: 0;
  border-radius: 7px;
  background: transparent;
  color: var(--muted);
  font-size: 1.2rem;
  cursor: pointer;
}

.color-library-remove:hover {
  background: var(--surface2);
  color: var(--danger);
}

.color-library-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin-top: 14px;
}

.color-library-actions .btn {
  flex: 1;
  padding-inline: 8px;
  font-size: 0.78rem;
}

.color-library-actions .btn:disabled {
  cursor: not-allowed;
  opacity: 0.5;
}

.image-drop-zone {
  min-height: 210px;
  margin-bottom: 22px;
  overflow: hidden;
  border: 1px dashed var(--line);
  border-radius: 12px;
  background: var(--surface);
  transition: border-color 140ms ease, background 140ms ease;
}

.image-drop-zone:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 3px;
}

.image-drop-zone.is-dragging {
  border-color: var(--accent);
  background: var(--surface2);
}

.image-drop-prompt {
  display: flex;
  min-height: 210px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 20px;
  color: var(--muted);
  text-align: center;
}

.image-drop-prompt strong {
  color: var(--ink);
  font-size: 1rem;
}

.image-upload-icon {
  display: grid;
  width: 42px;
  height: 42px;
  place-items: center;
  border: 1px solid var(--line);
  border-radius: 12px;
  color: var(--accent);
  font-size: 1.6rem;
}

.image-drop-prompt small {
  max-width: 380px;
  font-size: 0.75rem;
}

.image-preview-wrap {
  padding: 10px;
}

.image-preview {
  display: block;
  width: 100%;
  max-height: 320px;
  border-radius: 8px;
  object-fit: contain;
}

.image-preview-caption {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 10px 2px 0;
}

.image-preview-caption > span {
  overflow: hidden;
  color: var(--muted);
  font-size: 0.8rem;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.extracted-heading {
  align-items: center;
}

.extracted-empty {
  padding: 22px 12px;
  border: 1px dashed var(--line);
  border-radius: 10px;
  color: var(--muted);
  font-size: 0.85rem;
  text-align: center;
}

.extracted-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
  gap: 9px;
}

.extracted-swatch {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 6px;
  padding: 6px;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: var(--surface);
  color: var(--ink);
  cursor: grab;
  text-align: left;
  transition: transform 140ms ease, border-color 140ms ease;
}

.extracted-swatch:hover {
  transform: translateY(-2px);
  border-color: var(--accent);
}

.extracted-swatch:active {
  cursor: grabbing;
}

.extracted-swatch.is-collected {
  border-color: var(--accent);
}

.extracted-swatch-color {
  display: block;
  width: 100%;
  height: 58px;
  border-radius: 6px;
  background: var(--swatch-color);
}

.extracted-swatch-hex {
  overflow-wrap: anywhere;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 0.75rem;
  font-weight: 700;
}

.extracted-swatch-action {
  color: var(--muted);
  font-size: 0.72rem;
}

.color-workspace-status {
  min-height: 1.25em;
  margin: 14px 0 0;
  color: var(--muted);
  font-size: 0.8rem;
}

@media (max-width: 760px) {
  .color-workspace-columns {
    grid-template-columns: minmax(0, 1fr);
  }

  .color-library {
    position: static;
  }

  .color-library-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-height: 340px;
  }
}

@media (max-width: 420px) {
  .color-library,
  .image-extractor {
    padding: 11px;
  }

  .extracted-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .image-preview-caption {
    align-items: flex-start;
    flex-direction: column;
  }
}

/* Named color collections and direct image sampling */
.color-name-label {
  display: block;
  margin: 12px 0 6px;
  font-size: .85rem;
  font-weight: 600;
}
.color-name-input {
  width: 100%;
  min-width: 0;
  padding: 10px 12px;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: var(--surface);
  color: var(--ink);
}
.color-workspace .color-library-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 12px 0;
}
.color-workspace .color-library-actions .btn {
  min-width: 0;
}
.saved-collections {
  margin-top: 22px;
  padding-top: 16px;
  border-top: 1px solid var(--line);
}
.saved-collections h3 {
  margin: 0 0 10px;
}
.saved-collection-row {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 0;
  border-bottom: 1px solid var(--line);
}
.saved-collection-open {
  display: flex;
  align-items: center;
  gap: 10px;
  flex: 1;
  min-width: 0;
  text-align: left;
  border: 0;
  background: transparent;
  color: var(--ink);
  cursor: pointer;
}
.saved-collection-open > span:last-child {
  min-width: 0;
  overflow-wrap: anywhere;
}
.saved-collection-open small {
  display: block;
  color: var(--muted);
  margin-top: 2px;
}
.saved-collection-swatches {
  display: flex;
  flex-shrink: 0;
}
.saved-collection-swatches i {
  width: 13px;
  height: 26px;
  margin-left: -2px;
  border: 1px solid var(--surface);
  border-radius: 4px;
}
.image-sampling-target {
  cursor: crosshair;
  touch-action: none;
  user-select: none;
}
.color-workspace .extracted-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 18px;
}
@media (max-width: 700px) {
  .color-workspace-columns {
    grid-template-columns: minmax(0, 1fr);
  }
}

