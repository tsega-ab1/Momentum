# Copy to .env.local and set real values. .env.local is never committed.

# Signs the login cookie. Use a long random string, e.g. run: openssl rand -hex 32
SESSION_SECRET=change-me

# Set to true only when the site is served over https
COOKIE_SECURE=false

# The public address of the site (used in share links and the sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
