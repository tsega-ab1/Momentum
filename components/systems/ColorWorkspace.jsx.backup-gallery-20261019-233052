"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import { useRouter } from "next/navigation";
import { saveColorPaletteAction } from "@/app/actions";

const STORAGE_KEY = "momentum-color-library-v1";
const COLLECTIONS_KEY = "momentum-named-color-collections-v1";
const MAX_COLORS = 80;
const MAX_IMAGE_BYTES = 15 * 1024 * 1024;

function normalizeHex(value) {
  if (typeof value !== "string") return null;
  const cleaned = value.trim().replace(/^#/, "");
  return /^[0-9a-fA-F]{6}$/.test(cleaned) ? `#${cleaned.toUpperCase()}` : null;
}

function rgbToHex(r, g, b) {
  return "#" + [r, g, b]
    .map((v) => Math.max(0, Math.min(255, Math.round(v))).toString(16).padStart(2, "0"))
    .join("").toUpperCase();
}

function readFileAsDataUrl(file) {
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = () => resolve(reader.result);
    reader.onerror = () => reject(new Error("Could not read this image file."));
    reader.readAsDataURL(file);
  });
}

function extractDominantColors(image, limit = 12) {
  const canvas = document.createElement("canvas");
  const ctx = canvas.getContext("2d", { willReadFrequently: true });
  if (!ctx) throw new Error("Could not initialize image processing.");

  const scale = Math.min(1, 180 / image.naturalWidth, 180 / image.naturalHeight);
  canvas.width = Math.max(1, Math.round(image.naturalWidth * scale));
  canvas.height = Math.max(1, Math.round(image.naturalHeight * scale));
  ctx.drawImage(image, 0, 0, canvas.width, canvas.height);

  let pixels;
  try {
    pixels = ctx.getImageData(0, 0, canvas.width, canvas.height).data;
  } catch {
    throw new Error("This image cannot be read. Try uploading the image file directly.");
  }

  const buckets = new Map();
  const stride = Math.max(4, Math.floor(pixels.length / 12000 / 4) * 4);
  for (let i = 0; i < pixels.length; i += stride) {
    if (pixels[i + 3] < 115) continue;
    const key = rgbToHex(
      Math.round(pixels[i] / 24) * 24,
      Math.round(pixels[i + 1] / 24) * 24,
      Math.round(pixels[i + 2] / 24) * 24
    );
    const item = buckets.get(key) || { count: 0, r: 0, g: 0, b: 0 };
    item.count++;
    item.r += pixels[i];
    item.g += pixels[i + 1];
    item.b += pixels[i + 2];
    buckets.set(key, item);
  }

  return [...buckets.values()]
    .sort((a, b) => b.count - a.count)
    .slice(0, limit)
    .map((v) => ({ hex: rgbToHex(v.r / v.count, v.g / v.count, v.b / v.count) }));
}

export default function ColorWorkspace() {
  const router = useRouter();
  const [colors, setColors] = useState([]);
  const [collections, setCollections] = useState([]);
  const [collectionName, setCollectionName] = useState("");
  const [imageUrl, setImageUrl] = useState("");
  const [imageName, setImageName] = useState("");
  const [extracted, setExtracted] = useState([]);
  const [status, setStatus] = useState("");
  const [ready, setReady] = useState(false);
  const [busy, setBusy] = useState(false);
  const [draggingImage, setDraggingImage] = useState(false);
  const [sampling, setSampling] = useState(false);
  const fileInputRef = useRef(null);
  const imageRef = useRef(null);
  const sampleCanvasRef = useRef(null);
  const lastSampleRef = useRef("");

  useEffect(() => {
    try {
      const old = JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]");
      const oldColors = Array.isArray(old)
        ? old.map((v) => normalizeHex(typeof v === "string" ? v : v?.hex)).filter(Boolean)
        : [];
      const stored = JSON.parse(localStorage.getItem(COLLECTIONS_KEY) || "[]");
      const safeCollections = Array.isArray(stored)
        ? stored.filter((v) => v && typeof v.name === "string" && Array.isArray(v.colors))
            .map((v) => ({
              id: v.id || `${Date.now()}-${Math.random()}`,
              name: v.name,
              colors: [...new Set(v.colors.map(normalizeHex).filter(Boolean))].slice(0, MAX_COLORS),
            }))
        : [];
      if (!safeCollections.length && oldColors.length) {
        safeCollections.push({ id: "legacy-colors", name: "My Colors", colors: [...new Set(oldColors)].slice(0, MAX_COLORS) });
      }
      // eslint-disable-next-line react-hooks/set-state-in-effect
      setCollections(safeCollections);
      if (safeCollections.length) {
        setColors(safeCollections[0].colors);
        setCollectionName(safeCollections[0].name);
      } else {
        setColors([...new Set(oldColors)].slice(0, MAX_COLORS));
        setCollectionName("My Color Collection");
      }
    } catch {
      setStatus("Could not read the previous local color collection.");
    }
    setReady(true);
  }, []);

  useEffect(() => {
    if (!ready) return;
    try {
      localStorage.setItem(COLLECTIONS_KEY, JSON.stringify(collections));
      // Keep the previous key populated for compatibility with older workspace data.
      localStorage.setItem(STORAGE_KEY, JSON.stringify(colors));
    } catch {
      // eslint-disable-next-line react-hooks/set-state-in-effect
      setStatus("Browser storage is full. Copy or export your palette before leaving.");
    }
  }, [collections, colors, ready]);

  const addColor = useCallback((value) => {
    const hex = normalizeHex(value);
    if (!hex) return;
    setColors((previous) => {
      if (previous.includes(hex)) {
        setStatus(`${hex} is already in this collection.`);
        return previous;
      }
      if (previous.length >= MAX_COLORS) {
        setStatus(`A collection can contain up to ${MAX_COLORS} colors.`);
        return previous;
      }
      setStatus(`Added ${hex}.`);
      return [...previous, hex];
    });
  }, []);

  function removeColor(hex) {
    setColors((previous) => previous.filter((v) => v !== hex));
    setStatus(`Removed ${hex}.`);
  }

  async function copyText(value) {
    try {
      await navigator.clipboard.writeText(value);
      setStatus("Copied to clipboard.");
    } catch {
      setStatus(`Clipboard access was blocked: ${value}`);
    }
  }

  async function processFile(file) {
    if (!file) return;
    if (!file.type.startsWith("image/")) return setStatus("Choose a JPG, PNG, GIF, or WEBP image.");
    if (file.size > MAX_IMAGE_BYTES) return setStatus("Choose an image smaller than 15 MB.");

    setBusy(true);
    setStatus("Loading image…");
    setExtracted([]);
    try {
      setImageName(file.name || "Image");
      setImageUrl(await readFileAsDataUrl(file));
    } catch (error) {
      setBusy(false);
      setStatus(error.message || "Could not load this image.");
    }
  }

  function onImageLoaded() {
    const image = imageRef.current;
    if (sampleCanvasRef.current) {
      sampleCanvasRef.current.dataset.ready = "false";
    }
    if (!image?.naturalWidth) return;
    try {
      setExtracted(extractDominantColors(image, 12));
      setStatus("Image ready. Drag across it or click individual points to sample exact colors.");
    } catch (error) {
      setStatus(error.message || "Could not extract colors.");
    } finally {
      setBusy(false);
    }
  }

  function sampleAt(event) {
    const image = imageRef.current;
    if (!image?.naturalWidth || !imageUrl) return;
    const rect = image.getBoundingClientRect();
    const x = Math.floor(((event.clientX - rect.left) / rect.width) * image.naturalWidth);
    const y = Math.floor(((event.clientY - rect.top) / rect.height) * image.naturalHeight);
    if (x < 0 || y < 0 || x >= image.naturalWidth || y >= image.naturalHeight) return;

    try {
      let canvas = sampleCanvasRef.current;
      if (
        !canvas ||
        canvas.width !== image.naturalWidth ||
        canvas.height !== image.naturalHeight ||
        canvas.dataset.ready !== "true"
      ) {
        if (!canvas) {
          canvas = document.createElement("canvas");
          sampleCanvasRef.current = canvas;
        }
        canvas.width = image.naturalWidth;
        canvas.height = image.naturalHeight;
        const context = canvas.getContext("2d", { willReadFrequently: true });
        if (!context) throw new Error("Could not initialize the image color sampler.");
        context.drawImage(image, 0, 0);
        canvas.dataset.ready = "true";
      }
      const pixel = canvas
        .getContext("2d", { willReadFrequently: true })
        .getImageData(x, y, 1, 1).data;
      if (pixel[3] < 20) return;
      const hex = rgbToHex(pixel[0], pixel[1], pixel[2]);
      lastSampleRef.current = hex;
      setStatus(`Pixel color: ${hex}. Keep dragging to sample more colors.`);
      if (event.type === "click" || sampling || event.buttons === 1) addColor(hex);
    } catch {
      setStatus("Could not sample this image. Try uploading the original image file.");
    }
  }

  function dropImage(event) {
    event.preventDefault();
    setDraggingImage(false);
    const file = event.dataTransfer.files?.[0];
    if (file) processFile(file);
  }

  function dragColor(event, hex) {
    event.dataTransfer.setData("application/x-momentum-color", hex);
    event.dataTransfer.setData("text/plain", hex);
    event.dataTransfer.effectAllowed = "copy";
  }

  function dropColor(event) {
    event.preventDefault();
    const hex = event.dataTransfer.getData("application/x-momentum-color") ||
      event.dataTransfer.getData("text/plain");
    addColor(hex);
  }

  function saveLocalCollection() {
    const name = collectionName.trim();
    if (!name) return setStatus("Enter a collection name first.");
    if (!colors.length) return setStatus("Add at least one color before saving.");
    const id = `${Date.now()}`;
    setCollections((previous) => [
      ...previous.filter((c) => c.name.toLowerCase() !== name.toLowerCase()),
      { id, name, colors: [...colors] },
    ]);
    setStatus(`Saved "${name}" in this browser.`);
  }

  function loadCollection(collection) {
    setCollectionName(collection.name);
    setColors([...collection.colors]);
    setStatus(`Opened "${collection.name}".`);
  }

  function deleteLocalCollection(id) {
    setCollections((previous) => previous.filter((c) => c.id !== id));
    setStatus("Deleted the local collection.");
  }

  async function saveToSystems() {
    const name = collectionName.trim();
    if (!name) return setStatus("Enter a collection name first.");
    if (!colors.length) return setStatus("Add at least one color before saving.");
    setBusy(true);
    setStatus("Saving palette to My Systems…");
    try {
      const result = await saveColorPaletteAction({ name, colors });
      if (!result?.ok) {
        setStatus(result?.error || "Could not save to My Systems.");
        return;
      }
      setStatus(`Saved "${result.name}" to My Systems.`);
      router.refresh();
    } catch {
      setStatus("Could not save to My Systems. Check your connection and sign-in status.");
    } finally {
      setBusy(false);
    }
  }

  function onPaste(event) {
    const file = [...(event.clipboardData?.items || [])]
      .find((item) => item.type.startsWith("image/"))?.getAsFile();
    if (file) {
      event.preventDefault();
      processFile(file);
    }
  }

  return (
    <section className="card color-workspace" aria-labelledby="color-workspace-title">
      <div className="color-workspace-heading">
        <div>
          <p className="eyebrow">DESIGN WORKSPACE</p>
          <h2 id="color-workspace-title">Color Studio</h2>
          <p className="muted small">Sample colors from your images, build named collections, and save palettes to My Systems.</p>
        </div>
        <span className="color-workspace-count">{colors.length}/{MAX_COLORS} colors</span>
      </div>

      <div className="color-workspace-columns">
        <aside className="color-library" onDragOver={(e) => e.preventDefault()} onDrop={dropColor} aria-label="Color collections">
          <div className="color-section-heading">
            <div><h3>My collections</h3><p className="muted small">Drag swatches here or save your current palette.</p></div>
          </div>

          <label className="color-name-label" htmlFor="color-collection-name">Collection name</label>
          <input id="color-collection-name" className="color-name-input" value={collectionName} maxLength={80} onChange={(e) => setCollectionName(e.target.value)} placeholder="e.g. Habesha Coffee Brand" />

          <div className="color-library-actions">
            <button className="btn btn-primary" type="button" onClick={saveLocalCollection}>Save collection</button>
            <button className="btn" type="button" disabled={busy} onClick={saveToSystems}>Save to My Systems</button>
          </div>

          <div className="color-library-drop-hint">＋ Drop a sampled color here</div>
          {colors.length ? (
            <div className="color-library-list">
              {colors.map((hex) => (
                <div className="color-library-item" key={hex}>
                  <button className="color-library-chip" type="button" style={{ backgroundColor: hex }} onClick={() => copyText(hex)} aria-label={`Copy ${hex}`} title={`Copy ${hex}`} />
                  <button className="color-library-hex" type="button" onClick={() => copyText(hex)}>{hex}</button>
                  <button className="color-library-remove" type="button" onClick={() => removeColor(hex)} aria-label={`Remove ${hex}`}>×</button>
                </div>
              ))}
            </div>
          ) : (
            <div className="color-library-empty"><p>No colors yet.</p><p className="muted small">Click or drag over the image to pick colors.</p></div>
          )}
          <div className="color-library-actions">
            <button className="btn" type="button" disabled={!colors.length} onClick={() => copyText(colors.join(", "))}>Copy all HEX</button>
            <button className="btn" type="button" disabled={!colors.length} onClick={() => { setColors([]); setStatus("Cleared the current palette."); }}>Clear palette</button>
          </div>

          <div className="saved-collections">
            <h3>Saved collections</h3>
            {collections.length === 0 && <p className="muted small">Your browser-saved collections will appear here.</p>}
            {collections.map((item) => (
              <div className="saved-collection-row" key={item.id}>
                <button className="saved-collection-open" type="button" onClick={() => loadCollection(item)}>
                  <span className="saved-collection-swatches">
                    {item.colors.slice(0, 5).map((hex) => <i key={hex} style={{ backgroundColor: hex }} />)}
                  </span>
                  <span>{item.name}<small>{item.colors.length} colors</small></span>
                </button>
                <button className="color-library-remove" type="button" onClick={() => deleteLocalCollection(item.id)} aria-label={`Delete ${item.name}`}>×</button>
              </div>
            ))}
          </div>
        </aside>

        <div className="image-extractor">
          <div className="color-section-heading">
            <div><h3>Image color picker</h3><p className="muted small">Click a point or hold your mouse and drag across the image.</p></div>
            {busy && <span className="muted small">Processing…</span>}
          </div>

          <div className={`image-drop-zone${draggingImage ? " is-dragging" : ""}`}
            onDragOver={(e) => { e.preventDefault(); setDraggingImage(true); }}
            onDragLeave={() => setDraggingImage(false)}
            onDrop={dropImage} onPaste={onPaste} tabIndex={0}
            onKeyDown={(e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); fileInputRef.current?.click(); } }}>
            {imageUrl ? (
              <div className="image-preview-wrap">
                <img ref={imageRef} src={imageUrl} alt={`Color sampling image: ${imageName}`} className="image-preview image-sampling-target"
                  draggable={false} onLoad={onImageLoaded}
                  onPointerDown={(e) => {
                    e.preventDefault();
                    e.currentTarget.setPointerCapture?.(e.pointerId);
                    setSampling(true);
                    sampleAt({
                      clientX: e.clientX,
                      clientY: e.clientY,
                      type: "click",
                      buttons: 1
                    });
                  }}
                  onPointerMove={(e) => { if (sampling || e.buttons === 1) sampleAt(e); }}
                  onPointerUp={() => setSampling(false)}
                  onPointerCancel={() => setSampling(false)}
                  onClick={sampleAt}
                  onError={() => { setBusy(false); setStatus("Could not decode this image. Try another file."); }} />
                <div className="image-preview-caption">
                  <span title={imageName}>{imageName}</span>
                  <button type="button" className="btn" onClick={() => fileInputRef.current?.click()}>Change image</button>
                </div>
              </div>
            ) : (
              <div className="image-drop-prompt">
                <span className="image-upload-icon" aria-hidden="true">↑</span>
                <strong>Drop an image here</strong><span>or choose a file from your device</span>
                <button type="button" className="btn btn-primary" onClick={() => fileInputRef.current?.click()}>Choose image</button>
                <small>JPG, PNG, GIF, or WEBP · Up to 15 MB · Ctrl+V also works</small>
              </div>
            )}
          </div>
          <input ref={fileInputRef} className="visually-hidden" type="file" accept="image/*" aria-label="Choose image file"
            onChange={(e) => { processFile(e.target.files?.[0]); e.target.value = ""; }} />

          <div className="extracted-heading">
            <div><h3>Colors under the image</h3><p className="muted small">Sampled colors appear here. Click or drag a swatch to add it to your collection.</p></div>
            <button className="btn" type="button" disabled={!extracted.length} onClick={() => extracted.forEach(({ hex }) => addColor(hex))}>Add palette</button>
          </div>

          {extracted.length === 0 ? (
            <div className="extracted-empty">Upload an image to get dominant colors, then sample any pixel for an exact color.</div>
          ) : (
            <div className="extracted-grid">
              {extracted.map(({ hex }, index) => {
                const saved = colors.includes(hex);
                return <button key={`${hex}-${index}`} type="button" draggable
                  className={`extracted-swatch${saved ? " is-collected" : ""}`}
                  onDragStart={(e) => dragColor(e, hex)} onClick={() => addColor(hex)}
                  style={{ "--swatch-color": hex }} title={`${hex} — click or drag to add`}
                  aria-label={`Add ${hex} to collection`}>
                  <span className="extracted-swatch-color" /><span className="extracted-swatch-hex">{hex}</span>
                  <span className="extracted-swatch-action">{saved ? "✓ Saved" : "+ Add"}</span>
                </button>;
              })}
            </div>
          )}
          <canvas ref={sampleCanvasRef} hidden />
        </div>
      </div>
      <p className="color-workspace-status" role="status" aria-live="polite">
        {status || "Image processing happens locally. Save to My Systems to keep a named palette with your account."}
      </p>
    </section>
  );
}
